# ============================================================
# Environment Variables Configuration Template (Phase 1 & Phase 2)
# NOTE: Do NOT commit production credentials or actual secrets!
# ============================================================

# MongoDB Connectivity
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=midterm_data_pipeline

# File Router Engine Threshold (in MB)
# Files <= 200.0 MB are routed to Python Streaming Batch engine
# Files > 205.0 MB are routed to Apache PySpark engine
SMALL_FILE_THRESHOLD_MB=200.0

# Batch Processing
BATCH_SIZE=5000
SAMPLE_ROWS=500000

# PySpark Configuration
SPARK_APP_NAME=MidtermHybridDataPipeline
SPARK_MASTER_URL=local[*]

# FastAPI Server Configuration (Phase 2)
API_HOST=127.0.0.1
API_PORT=8000
